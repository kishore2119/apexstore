# Copy this file to .env and replace the placeholder values.
DATABASE_HOST=YOUR_HOST
# Optional: use one database with four service-owned schemas. Leave unset to keep
# the separate users_db/products_db/orders_db/invoices_db configuration below.
# DATABASE_NAME=ecomm
# In single-database mode replace all four service URLs with:
# USER_DB_URL=jdbc:postgresql://YOUR_HOST:26257/ecomm?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&currentSchema=users
# PRODUCT_DB_URL=jdbc:postgresql://YOUR_HOST:26257/ecomm?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&currentSchema=products
# ORDER_DB_URL=jdbc:postgresql://YOUR_HOST:26257/ecomm?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&currentSchema=orders
# INVOICE_DB_URL=jdbc:postgresql://YOUR_HOST:26257/ecomm?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&currentSchema=invoices
# Optional initialization connection; defaults to DATABASE_HOST:26257/defaultdb.
# For a local certificate authority, set this and all four service URLs with
# sslmode=verify-full&sslrootcert=C:/absolute/path/to/.local/cockroach/ca.crt
# rather than sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory.
# DATABASE_SETUP_URL=jdbc:postgresql://YOUR_HOST:26257/defaultdb?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USERNAME=YOUR_SQL_USER
DB_PASSWORD=replace-locally
USER_DB_URL=jdbc:postgresql://YOUR_HOST:26257/users_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
PRODUCT_DB_URL=jdbc:postgresql://YOUR_HOST:26257/products_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
ORDER_DB_URL=jdbc:postgresql://YOUR_HOST:26257/orders_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
INVOICE_DB_URL=jdbc:postgresql://YOUR_HOST:26257/invoices_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INTERNAL_API_KEY=replace-with-another-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@ecom.local
ADMIN_LOGIN_ID=ECOM-ADMIN
ADMIN_PASSWORD=replace-with-a-strong-private-password
FRONTEND_ORIGIN=http://localhost:4200
