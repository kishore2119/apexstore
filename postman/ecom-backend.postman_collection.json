{
  "info": {
    "name": "E-Commerce Backend — Project 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against the local gateway. This collection creates synthetic users, an order and an invoice, then deactivates its product fixture. Set adminPassword privately and adminId if changed from ECOM-ADMIN. Admin authentication uses its dedicated endpoint. The order read step polls pending checkout for up to 60 seconds in Collection Runner. No payment is collected. The optional WSDL request needs a private internalServiceKey and calls Invoice Service directly. Do not export populated credentials or tokens."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "buyerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "adminId",
      "value": "ECOM-ADMIN"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": "Local-demo-password-123"
    },
    {
      "key": "buyerId",
      "value": ""
    },
    {
      "key": "invoiceUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "internalServiceKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register seller",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Seller\",\n  \"email\": \"seller-{{runId}}@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.unset('productId');",
              "pm.collectionVariables.unset('orderId');",
              "pm.collectionVariables.unset('sellerToken');",
              "pm.collectionVariables.unset('buyerToken');",
              "pm.collectionVariables.unset('adminToken');",
              "pm.collectionVariables.set('orderPolls', '0');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created customer account for seller', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('sellerToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Enable selling — replace token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/users/me/seller",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Selling enabled', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.roles).to.include('SELLER'); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('sellerToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/seller/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"POSTMAN-{{runId}}\",\n  \"name\": \"Demo keyboard\",\n  \"description\": \"Academic API demo\",\n  \"category\": \"Electronics\",\n  \"price\": 499.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('productId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Set stock",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/seller/products/{{productId}}/stock",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stockOnHand\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Browse products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products?page=0&size=10&sort=price,asc"
      }
    },
    {
      "name": "6. Register buyer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Buyer\",\n  \"email\": \"buyer-{{runId}}@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Buyer registered', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const session = pm.response.json(); pm.collectionVariables.set('buyerToken', session.accessToken); pm.collectionVariables.set('buyerId', session.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Place order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Postman Buyer\",\n  \"customerEmail\": \"buyer-{{runId}}@example.test\",\n  \"address\": \"Academic demo address\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"deliveryAddress\": {\n    \"line1\": \"12 Test Street\",\n    \"line2\": \"\",\n    \"city\": \"Kakinada\",\n    \"state\": \"Andhra Pradesh\",\n    \"pincode\": \"533001\",\n    \"country\": \"India\",\n    \"phone\": \"9000000000\"\n  },\n  \"paymentMethod\": \"COD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order accepted',()=>pm.expect([200,202]).to.include(pm.response.code));",
              "pm.collectionVariables.set('orderId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Read order — wait for CONFIRMED",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order readable', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const order = pm.response.json();",
              "  if (order.status === 'PENDING') {",
              "    const polls = Number(pm.collectionVariables.get('orderPolls') || 0) + 1;",
              "    pm.collectionVariables.set('orderPolls', String(polls));",
              "    pm.test('Checkout completed within polling limit', () => pm.expect(polls).to.be.at.most(30));",
              "    pm.execution.setNextRequest(polls <= 30 ? pm.info.requestName : null);",
              "    if (polls <= 30) setTimeout(() => {}, 2000);",
              "  } else {",
              "    pm.test('Order confirmed with server total', () => { pm.expect(order.status).to.eql('CONFIRMED'); pm.expect(order.total).to.eql(999); });",
              "    if (order.status !== 'CONFIRMED') pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Generate SOAP-backed invoice",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}/invoice",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invoice generated',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Get invoice",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}/invoice",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11. Order history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders?page=0&size=10&sort=createdAt,desc",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "12. Seller listings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/seller/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "13. Admin login — set private credentials first",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"adminId\": \"{{adminId}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dedicated admin login', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.roles).to.eql(['ADMIN']); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Admin own listings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Own inventory returned', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Admin order summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/orders/summary",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Admin customer search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/users?search=buyer-{{runId}}%40example.test&page=0&size=10",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Admin recent orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/orders?page=0&size=10&sort=createdAt,desc",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "18. Admin customer order counts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/orders/customer-stats",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ids\": [\n    \"{{buyerId}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "19. Admin own inventory summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/products/summary",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "20. Admin cannot shop",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "21. Admin cannot change seller stock",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/products/{{productId}}/stock",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stockOnHand\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "22. Seller pauses own listing",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/seller/products/{{productId}}/status",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "23. Seller reactivates own listing",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/seller/products/{{productId}}/status",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "24. Hide verification listing",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/seller/products/{{productId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional SOAP inspection",
      "item": [
        {
          "name": "Read invoice SOAP contract",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Key",
                "value": "{{internalServiceKey}}"
              }
            ],
            "url": "{{invoiceUrl}}/ws/invoices.wsdl",
            "description": "Optional direct SOAP contract capture. Set the service key only in private local variables. Customer frontend code must never receive this key."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('internalServiceKey')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('WSDL returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('generateInvoice'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
