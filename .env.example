# Copy this file to .env and replace the placeholder values.
DB_USERNAME=sai
DB_PASSWORD=replace-locally
USER_DB_URL=jdbc:postgresql://YOUR_HOST:26257/users_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
PRODUCT_DB_URL=jdbc:postgresql://YOUR_HOST:26257/products_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
ORDER_DB_URL=jdbc:postgresql://YOUR_HOST:26257/orders_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
INVOICE_DB_URL=jdbc:postgresql://YOUR_HOST:26257/invoices_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INTERNAL_API_KEY=replace-with-another-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@ecom.local
ADMIN_PASSWORD=replace-with-a-strong-private-password
FRONTEND_ORIGIN=http://localhost:4200
