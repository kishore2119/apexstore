# Local credentials and environment overrides.
# Keep only explicitly named example files under version control.
.env
.env.*
!.env.example
!.env.*.example
/.local/

# Java and Maven generated output.
**/target/
**/*.class
**/*.jfr
**/hs_err_pid*
**/replay_pid*
**/.flattened-pom.xml
**/dependency-reduced-pom.xml

# Node.js and Angular dependencies, builds, caches, and reports.
**/node_modules/
/frontend/dist/
/frontend/tmp/
/frontend/out-tsc/
/frontend/.angular/
/frontend/coverage/
**/*.tsbuildinfo
**/.npm-cache/
**/.eslintcache
**/.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated browser previews and local runtime files.
/frontend/__screenshots__/
**/*.log
**/*.pid
**/*.pid.lock
**/*.tmp
**/*.temp

# IDE and editor metadata.
/.idea/
/.vscode/
**/.history/
**/*.iml
**/.classpath
**/.project
**/.settings/
**/*.sublime-workspace
**/*.sublime-project

# Operating-system metadata.
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
Desktop.ini
**/Desktop.ini
